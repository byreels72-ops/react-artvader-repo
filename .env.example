# Copy to .env.local (local dev) and add the same values in Vercel → Settings → Environment Variables.

# Resend API key — https://resend.com/api-keys
RESEND_API_KEY=

# Inbox for appointment requests (must be your Resend account email until a domain is verified)
BOOKING_TO_EMAIL=msalik909@gmail.com

# Optional, needs a verified domain in Resend
BOOKING_FROM_EMAIL=
BOOKING_SEND_CONFIRMATION=false
